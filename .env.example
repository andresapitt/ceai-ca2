GEMINI_API_KEY=
ALLOWED_ORIGIN=https://andresapitt.github.io

# Booking log (writes directly to a Google Sheet via a service account).
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY can be the raw PEM key or the whole
# downloaded JSON key file pasted as-is (client_email is auto-extracted from
# it if GOOGLE_SERVICE_ACCOUNT_EMAIL is left unset).
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
BOOKING_SHEET_ID=
# Optional — auto-detected from the sheet if unset (defaults to <first tab>!A:F:
# timestamp, tour_id, tour_name, adults, kids, total_price)
BOOKING_SHEET_RANGE=

# Booking confirmation email (Resend).
RESEND_API_KEY=
RESEND_FROM_EMAIL=
